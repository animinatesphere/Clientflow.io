# Base URL of the ClientFlow API running on your VPS.
# Leave blank to run the UI in demo mode with built-in sample data.
VITE_API_URL=https://api.clientflow.io

# Set to "true" to force demo mode even when VITE_API_URL is set.
VITE_DEMO_MODE=true

# Stripe / Paystack publishable key (billing pages read this)
VITE_PAYMENTS_PUBLIC_KEY=
